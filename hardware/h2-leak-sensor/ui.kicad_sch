	(text "J1 pin-out: 1 +3V3 (jig supplies 3.3 V, battery removed), 2 EN, 3 IO9/BOOT,\n4 TXD0 (GPIO24), 5 RXD0 (GPIO23), 6 USB D- (GPIO26), 7 USB D+ (GPIO27), 8 GND.\nUSB Serial/JTAG: esptool can enter download mode by itself.\nUART: the jig drives EN and IO9 (DTR/RTS auto-reset circuit lives on the jig)."
		(exclude_from_sim no)
		(at 83.82 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fb89769f-0e8b-597b-81f5-f9963de0ecaa")
	)
